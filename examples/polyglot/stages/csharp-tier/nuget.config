<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.DotNet.ILCompiler.LLVM, the AOT backend componentize-dotnet targets
     wasi-wasm through, ships only on the dotnet-experimental feed. Without this
     file the restore of BytecodeAlliance.Componentize.DotNet.Wasm.SDK resolves
     but its native toolchain dependency does not. `<clear />` keeps the restore
     independent of whatever feeds the machine has configured globally. -->
<configuration>
  <packageSources>
    <clear />
    <add key="dotnet-experimental" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json" />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
