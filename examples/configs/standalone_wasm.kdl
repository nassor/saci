// SACI standalone config running the Rust processor from
// `examples/wasm/order_processing/` under `saci-service`.
//
// The paths below are CWD-relative, so run from the repository root:
//   cargo build --release -p order-processing-wasm --target wasm32-wasip3
//   cargo run -p saci --features server,connector-file,codec-csv,wasm-host -- validate \
//     --config examples/configs/standalone_wasm.kdl --strict
//   cargo run -p saci --features server,connector-file,codec-csv,wasm-host -- serve \
//     --config examples/configs/standalone_wasm.kdl
//
// It reads examples/configs/fixtures/order_processing_input.csv, runs the processor,
// and writes /tmp/saci-order-processing-out.csv with `valid` and `usd_amount`
// filled in.
//
// The processor has no ingest system: rows arrive in the host's `run-batch` Arrow
// IPC payload, which is what the CSV source below produces. It also cannot add
// columns, so every `Transaction` field appears in both `field` lists and
// in the fixture. `valid` is seeded false and `usd_amount` zero; the processor
// overwrites both. Neither may be blank: the csv codec turns an empty field
// into a NULL, the fields are declared non-nullable, and one blank cell fails the
// whole batch.

mode "standalone"

node id=1 name="saci-order-processing" data_dir="${SACI_DATA_DIR:-/tmp/saci-order-processing}"

run "once"

workflow "order-processing" {
    // Both the file source and the file sink move CSV bytes, so one declared
    // codec serves them both.
    codec "csv_fmt" format="csv" {
        config has_headers=#true
    }

    // `component` must be "Transaction": the load-time graph check compares it
    // against the component names the processor reports from `describe()`.
    source "csv_orders" connector="file" component="Transaction" codec="csv_fmt" {
        config {
            path "examples/configs/fixtures/order_processing_input.csv"
            field "id" type="uint64" nullable=#false
            field "amount" type="float64" nullable=#false
            field "currency" type="utf8" nullable=#false
            field "valid" type="boolean" nullable=#false
            field "usd_amount" type="float64" nullable=#false
        }
    }

    // `cargo build --release --target wasm32-wasip3` writes the finished
    // component here: rustc links the cdylib into a component itself.
    wasm "process_orders" path="target/wasm32-wasip3/release/order_processing_wasm.wasm" {
        // FX rates the processor reads through the host-io `get-config` import,
        // one key per non-USD currency. Strings; the processor parses them with
        // `sdk::host::config_parse`.
        config fx_eur="1.08" fx_gbp="1.27" fx_jpy="0.0067" fx_cad="0.74"
    }

    // truncate replaces the file each run. Without it the sink appends, and
    // csv with has_headers writes a second header line mid-file.
    sink "csv_out" connector="file" component="Transaction" codec="csv_fmt" {
        config {
            path "/tmp/saci-order-processing-out.csv"
            truncate #true
            field "id" type="uint64" nullable=#false
            field "amount" type="float64" nullable=#false
            field "currency" type="utf8" nullable=#false
            field "valid" type="boolean" nullable=#false
            field "usd_amount" type="float64" nullable=#false
        }
    }

    link from="csv_orders" to="process_orders"
    link from="process_orders" to="csv_out"
}

http bind="127.0.0.1:0" enabled=#true

// Kept at full grade: a bounded `once` fixture run produces little span
// volume, so there is nothing to gain from sampling it down. See
// standalone.kdl for the flow_control rationale under `once`.
observability log_format="pretty" log_level="info" sample_ratio=1.0 error_sample_ratio=1.0
