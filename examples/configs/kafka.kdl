// SACI standalone service configuration driving Kafka at both ends.
//
// Run:
//   export KAFKA_BROKERS='localhost:9092'
//   cargo run --features connector-kafka,wasm --bin saci-service -- validate \
//     --config examples/configs/kafka.kdl
//   cargo run --features connector-kafka,wasm --bin saci-service -- serve \
//     --config examples/configs/kafka.kdl
//
// Two workflows. "orders" drains orders-raw once per cycle (stop_at_end
// #true) and writes to orders-enriched. "customers" reads the compacted
// topic customers-changelog as a one-shot snapshot (compacted #true) and
// mirrors it to customers-mirror, keeping deletes as tombstones
// (tombstones #true) instead of dropping them.
//
// `validate` opens no broker connection: every factory parses and
// validates its config and builds its librdkafka client, but connects
// lazily. The first drain cycle is where an unreachable broker, or a
// missing topic with provision create=#false, surfaces.

mode "standalone"

node id=1 name="saci-kafka" data_dir="${SACI_DATA_DIR:-/tmp/saci-kafka}"

// stop_at_end makes the source report EOF once every assigned partition is
// drained, so the interval runner can drive it without the stream runner. A
// live consumer (stop_at_end #false) never reaches EOF and instead needs
// run_mode kind="stream" with exactly one declared source.
run_mode kind="interval" interval_ms=2000

// Adaptive flow control: batch mode carries no per-item latency contract, so
// target_latency_ms stays 0 (the interval default) and the search chases
// throughput alone. Kafka's own poll batches admit up to batch_size (1000)
// rows at a time across two topics, so the ceiling is raised past the 65536
// default to let one admitted chunk match several full consumer polls.
flow_control {
    min_rows 2048
    max_rows 131072
    start_rows 8192
    adjust_interval_ms 15000
}

// One workflow declares the whole DAG: the byte format each end speaks, the
// source, the processor, the sink, and the explicit links between them.
workflow "orders" {
    // The transformer that decodes/encodes each message. "ndjson" is one JSON
    // object per message, decoded against schema_fields below; "arrow-ipc" is
    // one whole RecordBatch per message. Both need their transformer-*
    // feature compiled in.
    transformer "ndjson_fmt" format="ndjson"

    // ---------------------------------------------------------------- source

    // The processor's `describe()` supplies the component list, so `component`
    // on this source and the sink below must name components it declares.
    source "kafka_orders" type="KafkaSource" component="Order" transformer="ndjson_fmt" {
        config {
            brokers "${KAFKA_BROKERS:-localhost:9092}"
            topic "orders-raw"
            group_id "saci-orders"
            batch_size 1000
            poll_timeout_ms 1000
            auto_offset_reset "earliest"
            // Commits the previous batch's offsets at the start of the next poll,
            // so delivery is at-least-once: a crash between the two replays that
            // batch.
            commit_on_drain #true
            stop_at_end #true

            // Topics are created by default; set create=#false to opt out. A
            // missing topic then surfaces as a broker error from the consumer
            // instead of SACI silently provisioning one.
            provision create=#true partitions=3 replication_factor=1 timeout_ms=10000 {
                // Broker-side topic config for a topic this connector creates.
                // config "retention.ms"="604800000"
            }

            // Every librdkafka property SACI itself does not name goes in a
            // `properties` node, applied last so it overrides any default this
            // connector sets. There is no second way to set the same thing.
            // properties "session.timeout.ms"="45000"

            schema_fields "id" type="int64" nullable=#false
            schema_fields "status" type="utf8" nullable=#true
            schema_fields "total" type="float64" nullable=#true
        }
    }

    // ------------------------------------------------------------ processor

    wasm "process_orders" module="pipelines/orders.wasm"

    // ------------------------------------------------------------------ sink
    //
    // A different component than the source's: the processor declares both,
    // reads Order and writes EnrichedOrder. A sink's schema_fields must match
    // the component's RecordBatch field for field, in order.

    sink "kafka_enriched" type="KafkaSink" component="EnrichedOrder" transformer="ndjson_fmt" {
        config {
            brokers "${KAFKA_BROKERS:-localhost:9092}"
            topic "orders-enriched"
            // The rendered value of this column becomes the message key.
            // Row-per-message formats only: arrow-ipc emits one message per batch,
            // so there is no one row to key.
            key_field "id"
            flush_timeout_ms 30000

            provision create=#true partitions=3 replication_factor=1

            schema_fields "id" type="int64" nullable=#false
            schema_fields "status" type="utf8" nullable=#true
            schema_fields "total" type="float64" nullable=#true
        }
    }

    link from="kafka_orders" to="process_orders"
    link from="process_orders" to="kafka_enriched"
}

// A second workflow: customers-changelog is a compacted topic, read as a
// one-shot snapshot rather than a live consumer, mirrored to a topic that
// keeps deletes as tombstones instead of dropping them.
workflow "customers" {
    // Its own transformer node; workflows do not share declared ids.
    transformer "customers_json" format="ndjson"

    // ---------------------------------------------------------------- source

    // compacted #true reads the topic as a keyed log: one bounded pass from
    // the log start to the high watermark captured when the pass begins,
    // reduced to the newest value per key, tombstones (a null payload)
    // deleting a key instead of producing a row for it. The source reaches
    // EOF once that pass completes and stays at EOF after, so it needs no
    // run_mode kind="stream" either, the same as stop_at_end above.
    source "kafka_customers" type="KafkaSource" component="Customer" transformer="customers_json" {
        config {
            brokers "${KAFKA_BROKERS:-localhost:9092}"
            topic "customers-changelog"
            group_id "saci-customers-snapshot"
            batch_size 1000
            poll_timeout_ms 1000

            compacted #true
            // The column the raw message key decodes into. Compacted mode
            // only: it is what the snapshot is keyed on, and what a
            // tombstone names when it deletes.
            key_field "id"

            provision create=#true partitions=3 replication_factor=1

            schema_fields "id" type="int64" nullable=#false
            schema_fields "name" type="utf8" nullable=#true
            schema_fields "tier" type="utf8" nullable=#true
        }
    }

    // ------------------------------------------------------------ processor

    wasm "mirror_customers" module="pipelines/customers.wasm"

    // ------------------------------------------------------------------ sink
    //
    // Same component as the source's: this processor mirrors rows rather
    // than reshaping them.

    sink "kafka_customers_mirror" type="KafkaSink" component="Customer" transformer="customers_json" {
        config {
            brokers "${KAFKA_BROKERS:-localhost:9092}"
            topic "customers-mirror"
            key_field "id"
            // A row whose columns other than key_field are all null is
            // produced with a NULL payload instead of an encoded value: a
            // Kafka tombstone, mirroring a delete from the snapshot above
            // rather than dropping it.
            tombstones #true
            flush_timeout_ms 30000

            provision create=#true partitions=3 replication_factor=1

            schema_fields "id" type="int64" nullable=#false
            schema_fields "name" type="utf8" nullable=#true
            schema_fields "tier" type="utf8" nullable=#true
        }
    }

    link from="kafka_customers" to="mirror_customers"
    link from="mirror_customers" to="kafka_customers_mirror"
}

// HTTP control plane. /metrics carries the connector's counters.
http bind="127.0.0.1:0" disabled=#false

// Use log_format="json" in production log aggregators. Kept at a moderate
// 10% grade: two workflows redraining every 2 s produce enough per-item spans
// that full sampling would dominate stdout, but 1 in 10 still shows the
// shape of both. error_sample_ratio stays at 1.0.
observability log_format="pretty" log_level="info" sample_ratio=0.1 error_sample_ratio=1.0
