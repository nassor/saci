// SACI standalone service configuration replicating a MariaDB or MySQL table
// through the row binlog, with an initial consistent snapshot, into another
// server.
//
// Run:
//   export SACI_MARIADB_DSN='mysql://saci@localhost:3306/shop'
//   export SACI_MARIADB_SINK_DSN='mysql://saci@localhost:3307/shop'
//   cargo run --features connector-mariadb,wasm --bin saci-service -- validate \
//     --config examples/configs/mariadb.kdl
//   cargo run --features connector-mariadb,wasm --bin saci-service -- serve \
//     --config examples/configs/mariadb.kdl
//
// The source reads shop.orders: the snapshot arrives as `R` rows, then the
// binlog streams `I`, `U` and `D` rows from the position the snapshot pinned.
// The sink applies every change to shop.enriched_orders, deletes included.
// Either end may be a MariaDB or a MySQL server.
//
// `validate` opens no database connection: both factories parse and validate
// their config, build their TLS setup, and stop there. The first drain cycle is
// where an unreachable server, a missing table or a mistyped column surfaces.
//
// Source server prerequisites for cdc_binlog:
//   log_bin = ON
//   binlog_format = ROW
//   binlog_row_image = FULL
//   a unique server_id on the source server, different from the `server_id`
//   below, which the connector uses when it registers as a replica
//
// Grants for the source user:
//   GRANT SELECT ON shop.* TO 'saci'@'%';
//   GRANT REPLICATION SLAVE, REPLICATION CLIENT ON *.* TO 'saci'@'%';
//   REPLICATION SLAVE lets the connector read the binlog; REPLICATION CLIENT
//   lets it read the server's binlog position (MariaDB 10.5 and newer call
//   it BINLOG MONITOR and accept REPLICATION CLIENT as an alias).
//   The user also needs INSERT, UPDATE and CREATE on the offset table's schema,
//   because the connector stores its position in `saci_source_offsets`.
//
// Grants for the sink user:
//   GRANT SELECT, INSERT, UPDATE, DELETE ON shop.* TO 'saci'@'%';
//
// A DELETE row carries the full row image under binlog_row_image = FULL, but
// the sink only needs the key, so every non-key field below is nullable.

mode "standalone"

node id=1 name="saci-mariadb" data_dir="${SACI_DATA_DIR:-/tmp/saci-mariadb}"

// Re-drain every 2 s. Each MariaDB mode returns EOF once it is caught up, so
// the interval runner drives it without the stream runner.
run_mode kind="interval" interval_ms=2000

// Adaptive flow control: how many rows the runner admits from a source per
// pass, and how large the Arrow chunk handed downstream is. On by default
// for every source; declared here only to shorten the adjustment epoch.
// Adjustment decisions land at the close of one epoch (adjust_interval_ms),
// never per pass: this workflow redrains every 2 s, so the 60 s default
// would take thirty iterations to run one experiment. 10 s reacts sooner,
// at the cost of noisier per-epoch throughput measurements. Every other
// key below is the hard default, target_latency_ms included: it defaults
// to 0 in every batch mode (continuous and interval), because neither
// carries a per-item latency contract the way stream mode does.
flow_control {
    min_rows 1024
    max_rows 65536
    start_rows 4096
    max_chunk_bytes 8388608
    adjust_interval_ms 10000
}

// One workflow declares the whole DAG: the source, the processor, the sink,
// and the explicit links between them.
workflow "orders" {
    // ---------------------------------------------------------------- source

    // The processor's `describe()` supplies the component list, so `component`
    // on this source and the sink below must name components it declares.
    source "maria_orders" type="MariadbSource" component="OrderChange" {
        // Every source retries a failed operation with exponential backoff
        // before the error reaches the runner. The `retry` child sits beside
        // `config`; the connector's own `connection.reconnect` inside config
        // composes beneath it: reconnect re-establishes the session, and the
        // wrapper still retries the drained operation if it fails.
        retry max_attempts=8 base_delay_ms=500 multiplier=2.0 max_delay_ms=30000 jitter=0.1

        // The binlog reader is already sized by max_changes_per_cycle and
        // batch_rows below; rows pins the runner's admission credit to match
        // batch_rows, so every pass admits one whole chunk and the adaptive
        // search never touches this source.
        flow_control {
            rows 8192
        }

        // The `source` node's own id is what the service logs; the `name` inside
        // `config` is what the connector sees, because the factory is handed only
        // that table. It keys the metric labels and prefixes every error, so keep
        // the two equal.
        config {
            name "maria_orders"
            // Rows per emitted RecordBatch.
            batch_rows 8192
            // 0 drains until caught up; a positive value caps batches per iteration.
            max_batches_per_cycle 0

            connection {
                // Env-var placeholders are substituted before the file is parsed,
                // so no credential needs to live here. Nothing in the connector
                // ever logs the DSN, the user or the password: errors name the
                // target as host:port/database. A `mariadb://` scheme works too.
                dsn "${SACI_MARIADB_DSN}"
                // Optional override: `password_file` wins over `password`, for
                // secret mounts.
                // password_file "/run/secrets/saci-mariadb-password"
                connect_timeout_ms 5000
                statement_timeout_ms 30000
                // disabled, required (encrypted, certificate unchecked),
                // verify_ca or verify_identity (the default). Anything but
                // `disabled` needs the connector's `tls` feature, which the
                // saci-service `connector-mariadb` feature turns on.
                ssl_mode "required"
                // PEM bundle of trusted roots. Absent means the built-in roots.
                // ssl_ca "/etc/ssl/certs/mariadb-ca.pem"

                reconnect max_attempts=3 base_delay_ms=100 multiplier=2.0 \
                    max_delay_ms=30000 jitter=0.1
            }

            // polling, cdc_trigger or cdc_binlog.
            mode kind="cdc_binlog" {
                table "shop.orders"
                // `file` tracks file and position on both servers; `gtid`
                // tracks a GTID set and works on MySQL only.
                position "file"
                // The consistent snapshot reads the existing rows as `R`, then
                // the binlog continues from the position the snapshot pinned.
                // It needs a declared primary or unique key and is refused
                // together with an explicit `initial`.
                snapshot "initial"
                // Must be unique among the server's replicas. The default is
                // derived from the source name.
                server_id 4100
                // Changes read per cycle; a cycle always ends on a transaction
                // boundary, so one transaction can exceed it.
                max_changes_per_cycle 10000
                // Where the connector stores its binlog position.
                offset_table "saci_source_offsets"
                offset_table_autocreate #true
                // Keep the table's definitions, each tagged with the binlog
                // position it holds from, so a restart from a stored position
                // decodes every row with the definition in force when it was
                // written, an ALTER TABLE since included. `#false` decodes
                // with the current definition and keeps no table.
                schema_history #true
                // Defaults to the offset table's name with `_schema` appended.
                schema_history_table "saci_source_offsets_schema"
            }

            // `__`-prefixed fields are the reserved metadata columns cdc_binlog
            // fills: __op (utf8), __table (utf8), __binlog_file (utf8),
            // __binlog_pos (uint64), __gtid (utf8) and __commit_ts
            // (timestamp_micros_utc). Declare only the ones the pipeline needs.
            schema_fields "__op" type="utf8" nullable=#false
            schema_fields "__binlog_file" type="utf8" nullable=#false
            schema_fields "__binlog_pos" type="uint64" nullable=#false
            schema_fields "__commit_ts" type="timestamp_micros_utc" nullable=#true
            schema_fields "id" type="int64" nullable=#false
            schema_fields "status" type="utf8" nullable=#true
            // DECIMAL maps to decimal128 and needs the column's own precision and
            // scale; a mismatch is refused at the first connect.
            schema_fields "amount" type="decimal128" precision=18 scale=4 nullable=#true
        }
    }

    // ------------------------------------------------------------ processor

    wasm "process_orders" module="pipelines/orders.wasm"

    // ------------------------------------------------------------------ sink
    //
    // A different component than the source's: the processor declares both,
    // reads OrderChange and writes EnrichedOrder. A sink's schema_fields must
    // match the component's RecordBatch field for field, in order, so pointing
    // a sink at the source's component would mean repeating the source's
    // schema verbatim.

    sink "maria_enriched" type="MariadbSink" component="EnrichedOrder" {
        // A failed write or finish retries the same way, so a dropped session
        // mid-write re-queues the rows instead of failing the cycle.
        retry max_attempts=8 base_delay_ms=500 multiplier=2.0 max_delay_ms=30000 jitter=0.1

        config {
            name "maria_enriched"
            table "shop.enriched_orders"
            // append, upsert, ignore_conflicts or apply_changes. apply_changes
            // reads the declared `__op` field of each row (I, U, D, R) and
            // inserts, updates or deletes by the conflict columns, in row
            // order, which is what keeps the target equal to the source.
            write_mode "apply_changes"
            conflict_columns "id"
            // An omitted update_columns means every written column except the
            // conflict columns. dedupe_order_column is refused here: the row
            // order is the change order.
            //
            // Rows per INSERT statement inside one transaction.
            chunk_rows 1000
            // 0 flushes on every write_batch, which is one transaction per
            // iteration.
            flush_rows 0
            truncate_before_first_write #false

            connection dsn="${SACI_MARIADB_SINK_DSN}" ssl_mode="required"

            // `__op` is read for the operation and is not a table column.
            schema_fields "__op" type="utf8" nullable=#false
            schema_fields "id" type="int64" nullable=#false
            schema_fields "status" type="utf8" nullable=#true
            // The declared precision and scale must be no wider than the
            // target column's.
            schema_fields "total" type="decimal128" precision=18 scale=4 nullable=#true
        }
    }

    link from="maria_orders" to="process_orders"
    link from="process_orders" to="maria_enriched"
}

// HTTP control plane. /metrics carries the connector's counters:
// saci_mariadb_source_rows_total, saci_mariadb_source_batches_total,
// saci_mariadb_sink_flushes_total and the rest.
http bind="127.0.0.1:0" disabled=#false

// Use log_format="json" in production log aggregators. Kept at a 30%
// grade: a cdc_binlog source redraining every 2 s produces a steady
// stream of per-item spans, so 30% keeps enough of them to see the shape
// of a run without the full volume. error_sample_ratio stays at 1.0.
observability log_format="pretty" log_level="info" sample_ratio=0.3 error_sample_ratio=1.0
