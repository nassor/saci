// SACI standalone service configuration driving ClickHouse at both ends.
//
// Run:
//   export SACI_CLICKHOUSE_URL='http://localhost:8123'
//   cargo run --features connector-clickhouse,wasm --bin saci-service -- validate \
//     --config examples/configs/clickhouse.kdl
//   cargo run --features connector-clickhouse,wasm --bin saci-service -- serve \
//     --config examples/configs/clickhouse.kdl
//
// The source reads from `events_in` via polling mode and the sink writes
// enriched batches into `events_out` via native Arrow IPC streaming.
//
// `validate` opens no database connection: both factories parse and validate
// their config without connecting. The first drain cycle is where an unreachable
// server or missing table surfaces.

mode "standalone"

node id=1 name="saci-clickhouse" data_dir="${SACI_DATA_DIR:-/tmp/saci-clickhouse}"

// Re-drain every 2 s in interval mode.
run_mode kind="interval" interval_ms=2000

flow_control {
    min_rows 1024
    max_rows 65536
    start_rows 4096
    max_chunk_bytes 8388608
    adjust_interval_ms 10000
}

workflow "analytics" {
    source "ch_events" type="ClickhouseSource" component="Event" {
        retry max_attempts=5 base_delay_ms=500 multiplier=2.0 max_delay_ms=10000 jitter=0.1

        config {
            name "ch_events"
            batch_rows 8192
            max_batches_per_cycle 0

            connection {
                url "${SACI_CLICKHOUSE_URL:-http://localhost:8123}"
                database "default"
                connect_timeout_ms 5000
                query_timeout_ms 30000
                compression "lz4"
            }

            mode kind="polling" table="events_in" cursor_column="id"

            schema_fields "id" type="uint64" nullable=#false
            schema_fields "device_id" type="utf8" nullable=#true
            schema_fields "metric" type="float64" nullable=#true
        }
    }

    wasm "process_events" module="pipelines/analytics.wasm"

    sink "ch_enriched" type="ClickhouseSink" component="EnrichedEvent" {
        retry max_attempts=5 base_delay_ms=500 multiplier=2.0 max_delay_ms=10000 jitter=0.1

        config {
            name "ch_enriched"
            table "events_out"
            write_mode "append"
            chunk_rows 65536
            flush_rows 0
            truncate_before_first_write #false

            connection {
                url "${SACI_CLICKHOUSE_URL:-http://localhost:8123}"
                database "default"
                connect_timeout_ms 5000
                query_timeout_ms 30000
                compression "lz4"
            }

            schema_fields "id" type="uint64" nullable=#false
            schema_fields "device_id" type="utf8" nullable=#true
            schema_fields "metric" type="float64" nullable=#true
        }
    }

    link from="ch_events" to="process_events"
    link from="process_events" to="ch_enriched"
}

http bind="127.0.0.1:0" disabled=#false

observability log_format="pretty" log_level="info" sample_ratio=0.3 error_sample_ratio=1.0
